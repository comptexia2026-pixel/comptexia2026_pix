\section{Complexit\'e}
%% ============================================================================

\begin{table}[h]
\centering
\begin{tabular}{lll}
\toprule
\textbf{\'Etape} & \textbf{Op\'eration} & \textbf{Complexit\'e} \\
\midrule
Signatures & Quantification de chaque $x_0$ & $O(N)$ \\
Similarit\'e & Intersection souple entre lignes & $O(L \cdot \bar{m}^2)$ \\
Zones & Parcours s\'equentiel & $O(L)$ \\
Colonnes stables & Comptage par position & $O(L \cdot \bar{m})$ \\
Filtrage & Variance par colonne & $O(N)$ \\
Classification & R\`egles fixes & $O(T)$ \\
Extraction & Assignation + concat\'enation & $O(N)$ \\
\midrule
\textbf{Total} & & $O(N + L \cdot \bar{m}^2)$ \\
\bottomrule
\end{tabular}
\caption{Complexit\'e par \'etape. $N$ = nombre de mots, $L$ = nombre de lignes, $\bar{m}$ = nombre moyen de colonnes par ligne, $T$ = nombre de zones.}
\end{table}

En pratique, $\bar{m} \leq 10$ et $L \ll N$, donc la complexit\'e est lin\'eaire en $N$.


%% ============================================================================
\section{Propri\'et\'es}
%% ============================================================================

\begin{propriete}[Compl\'etude]
Toute s\'equence de $\gamma$ lignes ou plus ayant $\alpha$ colonnes align\'ees en commun est d\'etect\'ee comme zone tabulaire. Aucun tableau r\'eel n'est manqu\'e si $\gamma$, $\alpha$ et $\epsilon$ sont correctement calibr\'es.
\end{propriete}

\begin{propriete}[S\'eparabilit\'e]
Un paragraphe de texte justifi\'e \`a gauche a typiquement $M \leq 2$ colonnes stables (marge gauche + \'eventuel retrait) et $\bar{\sigma} > 50$ pt. Le crit\`ere $M \geq 3$ et/ou $\bar{\sigma} < \sigma_{\max}$ le rejette.
\end{propriete}

\begin{propriete}[Invariance au nombre de pages]
L'algorithme traite chaque page ind\'ependamment (condition $p_i = p_{i-1}$ dans l'alignement). Un tableau ne peut pas s'\'etendre sur deux pages.
\end{propriete}

\begin{propriete}[Sensibilit\'e au param\`etre $b$]
Si $b$ est trop petit ($b < 3$), des mots l\'eg\`erement d\'ecal\'es cr\'eent des colonnes distinctes. Si $b$ est trop grand ($b > 10$), des colonnes proches sont fusionn\'ees. La valeur $b = 5$ est un compromis pour les PDFs financiers o\`u les colonnes sont espac\'ees de 20--100 pt.
\end{propriete}


