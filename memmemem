\section{Limites identifi\'ees}
% =============================================================================

\subsection{Limites li\'ees au corpus}

\begin{enumerate}
  \item \textbf{\'Echantillon mono-\'emetteur} : les 312 documents proviennent
        exclusivement de BIL. La performance sur d'autres \'emetteurs (layouts
        diff\'erents, conventions diff\'erentes) n'est pas mesur\'ee.

  \item \textbf{Absence de CLN} : le composant CLN n'a pas pu \^etre valid\'e.
        Un corpus compl\'ementaire contenant des Credit Linked Notes est
        n\'ecessaire.

  \item \textbf{Absence de documents multidevises} : les 4 erreurs Currency
        sugg\`erent une difficult\'e sur les documents pr\'esentant plusieurs
        devises. L'\'echantillon ne permet pas de quantifier pr\'ecis\'ement
        ce ph\'enom\`ene.
\end{enumerate}

\subsection{Limites techniques}

\begin{enumerate}
  \item \textbf{Pas d'OCR} : les contenus en image (logos, tampons, ISINs
        non textuels) ne sont pas lisibles. Cela concerne 1 document sur 312.

  \item \textbf{Documents KID} : le mod\`ele ne distingue pas un term sheet
        d'un KID. Les KID suivent un format r\'eglementaire diff\'erent et
        produisent des r\'esultats incoh\'erents.

  \item \textbf{Zone de recherche SSPA} : la recherche du code SSPA est
        limit\'ee aux 800 premiers caract\`eres. Certains documents placent
        ce code plus loin.

  \item \textbf{D\'etection des sous-jacents} : le module d'extraction de
        tickers Bloomberg ne couvre pas toutes les configurations de tables
        de sous-jacents, impactant directement le champ W/A.
\end{enumerate}


% =============================================================================
\section{Recommandations}
% =============================================================================

\subsection{Priorit\'e haute}

\subsubsection{Am\'elioration du composant Currency}

\begin{enumerate}
  \item \'Elargir les patterns regex pour couvrir les labels de devise
        non standard (variantes multilingues, abr\'eviations).
  \item Ajouter une logique de d\'esambigu\"isation lorsque plusieurs devises
        sont pr\'esentes : privil\'egier la devise associ\'ee au label
        <<~Settlement Currency~>> sur <<~Underlying Currency~>>.
  \item Augmenter la couverture de la table \texttt{LABEL\_TO\_FIELD}
        pour les labels de devise.
\end{enumerate}

\subsubsection{Am\'elioration de l'extraction des sous-jacents}

\begin{enumerate}
  \item \'Elargir la zone de recherche des tickers Bloomberg au-del\`a de
        la section <<~UNDERLYING~>>.
  \item Ajouter des noms de bourses suppl\'ementaires dans la liste de
        recherche.
  \item Impl\'ementer une d\'etection par structure de tableau (colonnes
        align\'ees verticalement contenant des noms d'actions).
\end{enumerate}

\subsection{Priorit\'e moyenne}

\subsubsection{Am\'elioration du parsing SSPA}

\begin{enumerate}
  \item \'Elargir la zone de recherche de 800 \`a 1500 caract\`eres.
  \item Ajouter des patterns pour les positionnements atypiques du code SSPA
        (en bas de page, dans un encadr\'e, apr\`es un saut de ligne multiple).
\end{enumerate}

\subsubsection{Gestion des documents KID}

\begin{enumerate}
  \item Impl\'ementer un filtre en amont d\'etectant les documents KID
        (pr\'esence de <<~Key Information Document~>> ou <<~PRIIPs~>> dans
        les premiers caract\`eres).
  \item Exclure ces documents du traitement ou les traiter avec un
        extracteur d\'edi\'e.
\end{enumerate}

\subsection{Priorit\'e basse}

\begin{enumerate}
  \item Valider le composant CLN sur un corpus contenant des Credit Linked Notes.
  \item \'Evaluer l'ajout d'un module OCR pour les rares cas de contenu en image.
  \item \'Etendre la validation \`a un corpus multi-\'emetteurs (objectif :
        50 \'emetteurs, 1000+ documents).
\end{enumerate}


