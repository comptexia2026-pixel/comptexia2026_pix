\section{Analyse de la robustesse}
% =============================================================================

\subsection{Points forts}

\begin{enumerate}
  \item \textbf{ISIN} : extraction parfaite (100\% de pr\'ecision effective).
        La double validation (nom de fichier + contenu PDF) confirme la
        fiabilit\'e de l'algorithme de scoring par proximit\'e.

  \item \textbf{BIL} : d\'etection infaillible sur le corpus test\'e. La
        m\'ethode par mots-cl\'es (adresse, nom complet) est adapt\'ee au
        cas d'usage mono-\'emetteur.

  \item \textbf{Issuer} : aucune erreur de classification. Le mod\`ele
        privil\'egie la pr\'ecision sur le rappel --- il pr\'ef\`ere ne pas
        r\'epondre plut\^ot que de donner une valeur incorrecte.

  \item \textbf{Capital Protection} : les 8 \'ecarts sont enti\`erement
        explicables (KID hors scope + positionnement SSPA atypique).
        Aucune erreur sur les documents conformes.

  \item \textbf{Maturity} : coh\'erence globale. L'\'ecart syst\'ematique
        de $\sim$5 jours est une diff\'erence de d\'efinition, non une erreur.
\end{enumerate}

\subsection{Points faibles}

\begin{enumerate}
  \item \textbf{Currency} : taux d'\'echec de 15,1\% dont 4 erreurs r\'eelles.
        C'est le seul composant produisant des valeurs incorrectes (et non
        simplement manquantes). Priorit\'e \'elev\'ee.

  \item \textbf{Worst/Average} : 19 valeurs ind\'etermin\'ees (\texttt{nan})
        dues \`a la non-d\'etection des sous-jacents. Le composant en lui-m\^eme
        fonctionne correctement --- le probl\`eme est en amont.

  \item \textbf{CLN} : impossible \`a valider faute de donn\'ees. Le mod\`ele
        n'a jamais \'et\'e confront\'e \`a un vrai positif.
\end{enumerate}

